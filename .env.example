# ==============================================================================
# SMART ATTENDANCE SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# MongoDB Atlas Connection String
# Get your connection string from https://cloud.mongodb.com
# Steps:
# 1. Sign in to MongoDB Atlas -> Clusters -> Click "Connect"
# 2. Choose "Drivers" (Node.js)
# 3. Copy the connection string and replace <username> and <password>
#
# Example Format:
# MONGODB_URI=mongodb+srv://admin:your_password@cluster0.abcde.mongodb.net/smart_attendance?retryWrites=true&w=majority
MONGODB_URI=

# Database Name in Atlas (Default: smart_attendance)
DB_NAME=smart_attendance

# Authentication Token Secret
# Replace with a long random string in production (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here
